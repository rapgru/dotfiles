#!/bin/bash
set -euo pipefail

# Re-run this script whenever the global mise config changes:
# {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}

# Ensure Homebrew is in PATH so mise is accessible in non-interactive subshell
test -x /opt/homebrew/bin/brew && eval "$(/opt/homebrew/bin/brew shellenv)"
test -x /home/linuxbrew/.linuxbrew/bin/brew && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
test -x /usr/local/bin/brew && eval "$(/usr/local/bin/brew shellenv)"

if command -v mise >/dev/null 2>&1; then
    echo "==> Installing mise tools from global config..."
    mise install --yes
fi