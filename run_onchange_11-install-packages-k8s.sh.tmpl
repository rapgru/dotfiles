#!/bin/bash
set -euo pipefail

{{ if not .k8s }}
echo "Skipping k8s packages"
exit 0
{{ end }}

{{ template "brew-shellenv.sh" . }}

brew bundle --file=/dev/stdin <<EOF
brew "azure-cli"
# Required by the Shift-X plugin in .config/k9s/plugins/cdebug.yaml, which is
# silently dead without it -- k9s just flashes the shell exiting non-zero.
brew "cdebug"
brew "glab"
brew "k9s"
brew "opentofu"
brew "kubectl"
brew "helm"
brew "step"
brew "shellcheck"
brew "shfmt"
brew "terraform-docs"
brew "notation"
EOF
